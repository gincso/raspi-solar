[Unit]
Description=SunGoldPower 10kW Solar Inverter Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/raspi-solar
ExecStart=/usr/bin/python3 /opt/raspi-solar/sungoldpower.py --config /etc/raspi-solar/config.yaml
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
